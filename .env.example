APP_NAME=Hupu Sports Comment Insight Agent
ENVIRONMENT=local
# Relative SQLite paths are resolved from the project root.
DATABASE_URL=sqlite:///./comment_insight.db
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333

# mock | openai | deepseek | qwen | siliconflow
LLM_PROVIDER=mock
LLM_MODEL=
LLM_BASE_URL=

OPENAI_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=
SILICONFLOW_API_KEY=
SILICONFLOW_VISION_MODEL=Qwen/Qwen3.5-4B

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Local product runtime
UPLOAD_DIR=data/uploads
MAX_UPLOAD_MB=10
TASK_WORKER_COUNT=2
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
